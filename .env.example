# cp .env.example .env — docker compose picks it up automatically

# The container runs as this uid/gid and squad-data/ must be owned by it. Leave at 1000
# unless `id -u` / `id -g` say otherwise; changing it requires `docker compose up --build`.
PUID=1000
PGID=1000

SERVER_NAME="Squad Dedicated Server"
PORT=7787
QUERYPORT=27165
RCONPORT=21114
BEACONPORT=15000
FIXEDMAXPLAYERS=100
FIXEDMAXTICKRATE=64
# bash array, space separated workshop ids: MODS="(13371337 12341234)"
MODS="()"
# only with multiple IP addresses: the one the server should bind to
MULTIHOME=
